# LLM Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Proxy Authentication
PROXY_AUTH_TOKEN=your_secure_proxy_auth_token_here

# App Configuration
# DEBUG: If true, enables FastAPI hot-reload and advanced error pages.
DEBUG=false

# LOG_LEVEL: Sets the granularity of console logs. Use DEBUG to see individual PII detections and payloads.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# USE_GPU: If true, attempts to use CUDA for NuNER/GLiNER instead of CPU.
# Note: Requires 'torch' version with CUDA support and compatible hardware.
USE_GPU=false

HOST=0.0.0.0
PORT=8000
