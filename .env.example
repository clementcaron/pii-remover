# LLM Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Proxy Authentication
PROXY_AUTH_TOKEN=your_secure_proxy_auth_token_here

# App Configuration
# DEBUG: If true, enables FastAPI hot-reload and advanced error pages.
DEBUG=false

# LOG_LEVEL: Sets the granularity of console logs.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# USE_GPU: 
# - LOCAL: Set to true if you have a CUDA-compatible GPU for faster inference.
# - DOCKER: Defaulted to false for reliability.
USE_GPU=false

# Networking
HOST=0.0.0.0
PORT=8000

# Note: Model weights are persisted in a Docker volume 'hf_cache' 
# mounted to /home/appuser/.cache. No folder needed on host.
